    <p
      class="footer-headline max-w-[20ch] py-[var(--space-2xl)] pt-[var(--space-4xl)] text-8xl font-normal tracking-normal"
      data-split-text
    >
      We're always up for conversation<br />Let's connect
    </p>
  </div>
  <div
    class="page footer__widgets flex flex-1 flex-col justify-end gap-[var(--space-l)]"
  >
    <div class="grid grid-cols-1 gap-12 md:grid-cols-4 lg:gap-24">
      <Widget title="Join our Newsletter">
        <Newsletter />
      </Widget>
      <Widget title="Address">
        <address>
          <ul role="list" class="list-none">
            {footer?.address?.company && <li>{footer.address.company}</li>}
            {footer?.address?.street && <li>{footer.address.street}</li>}
            {footer?.address?.city && <li>{footer.address.city}</li>}
            {footer?.address?.country && <li>{footer.address.country}</li>}
          </ul>
        </address>
      </Widget>
      <Widget title="Socialize">
        <ul role="list" class="list-none">
          {
            footer?.social?.instagram && (
              <li>
                <a
                  href={footer.social.instagram}
                  aria-label="Follow us on instagram"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Instagram
                </a>
              </li>
            )
          }
          {
            footer?.social?.behance && (
              <li>
                <a
                  href={footer.social.behance}
                  aria-label="Follow us on behance"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Behance
                </a>
              </li>
            )
          }
          {
            footer?.social?.linkedin && (
              <li>
                <a
                  href={footer.social.linkedin}
                  aria-label="Follow us on linkedin"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Linkedin
                </a>
              </li>
            )
          }
        </ul>
      </Widget>
      <Widget title="Get in touch">
        <ul role="list" class="list-none">
          {
            footer?.contact?.phone && (
              <li>
                <a
                  href={`tel:${footer.contact.phone.replace(/\s/g, '')}`}
                  aria-label="Call us"
                >
                  {footer.contact.phone}
                </a>
              </li>
            )
          }
          {
            footer?.contact?.email && (
              <li>
                <a
                  href={`mailto:${footer.contact.email}?subject=Hello!`}
                  aria-label="E-mail us"
                >
                  {footer.contact.email}
                </a>
              </li>
            )
          }
        </ul>
      </Widget>
    </div>
    <div
      class="text-2xs legal page flex items-end justify-between py-[var(--space-s)] text-xs"
    >
      <button
        data-cc="show-preferencesModal"
        type="button"
        class="button-cookieconsent">Cookie Preferences</button
      >
      <p>
        &copy; {currentYear} - Narwal Creative
      </p>
      <div class="flex gap-4">
        {
          termsAndConditionsUrl ? (
            <a
              href={termsAndConditionsUrl}
              aria-label="Read our legal Terms & Conditions"
              target="_blank"
              rel="noopener noreferrer"
            >
              Terms & Conditions
            </a>
          ) : (
            <a
              href="#"
              aria-label="Terms & Conditions not available"
              class="cursor-not-allowed opacity-50"
            >
              Terms & Conditions
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  /* * > * {
    border: 1px solid red;

  } */

  p {
    margin: 0;
  }

  address {
    font-style: normal;
  }

  footer {
    width: 100%;
    background: var(--footer-bg);
    color: var(--footer-text);
  }

  @media (min-width: 1024px) {
    footer {
      position: sticky;
      bottom: 0;
      left: 0;
      z-index: 0;
    }
  }

  .footer__top {
    margin-block: 0;
  }

  .footer__widgets {
    margin-block: 0;
  }

  ul li {
    margin-block: 0.0125em;
    font-size: var(--fs--3);
    line-height: 150%;
  }

  ul li a {
    opacity: 0.9;
    text-decoration: none;
    color: var(--footer-link);
  }

  footer .legal {
    font-size: var(--fs--3);
  }

  .button-cookieconsent {
    border: none;
    background: var(--footer-button-bg);
    color: var(--footer-button-text);
  }

  footer .legal a {
    color: var(--footer-link);
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-headline[data-split-text]:not(.is-ready) {
      opacity: 0;
      animation: footer-split-fallback 0s 1.5s forwards;
    }

    .footer-headline[data-split-text].is-ready {
      animation: none;
    }
  }

  @keyframes footer-split-fallback {
    to {
      opacity: 1;
    }
  }

  .footer-headline :global(.footer-word),
  .footer-headline :global(.footer-word-mask) {
    display: inline-block;
    vertical-align: top;
  }
</style>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion, whenPageReady } from '../lib/gsap-inview';
  import { getLenis } from '../lib/lenis';

  gsap.registerPlugin(SplitText, ScrollTrigger);

  let ctx: gsap.Context | undefined;
  let initToken = 0;
  const scrollListeners: Array<() => void> = [];

  function cleanup() {
    scrollListeners.splice(0).forEach((off) => off());
    ctx?.revert();
    ctx = undefined;
  }

  async function initFooterSplit() {
    const token = ++initToken;
    cleanup();

    const headlines = document.querySelectorAll<HTMLElement>(
      '.footer-headline[data-split-text]',
    );
    if (!headlines.length) return;

    if (prefersReducedMotion()) {
      headlines.forEach((headline) => headline.classList.add('is-ready'));
      return;
    }

    await document.fonts.ready;
    if (token !== initToken) return;

    const readyHeadlines = document.querySelectorAll<HTMLElement>(
      '.footer-headline[data-split-text]',
    );
    if (!readyHeadlines.length) return;

    ctx = gsap.context(() => {
      readyHeadlines.forEach((headline) => {
        if (!document.contains(headline)) return;

        const split = SplitText.create(headline, {
          type: 'words',
          mask: 'words',
          aria: 'auto',
          tag: 'span',
          wordsClass: 'footer-word',
        });

        const tween = gsap.from(split.words, {
          yPercent: 150,
          duration: 0.8,
          ease: 'expo.out',
          stagger: 0.08,
          paused: true,
          onComplete: () => split.revert(),
        });

        headline.classList.add('is-ready');

        let played = false;

        const getStartAt = () => {
          const max = ScrollTrigger.maxScroll(window);
          if (max <= 0) return 0;
          const viewportHeight =
            window.innerHeight || document.documentElement.clientHeight;
          return Math.max(0, max - viewportHeight * 0.1);
        };

        const isNearPageBottom = () => {
          const current =
            window.scrollY || document.documentElement.scrollTop;
          return current >= getStartAt();
        };

        const tryPlay = () => {
          if (played || token !== initToken) return;
          if (!isNearPageBottom()) return;

          played = true;
          whenPageReady(() => {
            if (token !== initToken) return;
            tween.play();
          });
        };

        ScrollTrigger.create({
          start: () => getStartAt(),
          end: 'max',
          invalidateOnRefresh: true,
          onEnter: tryPlay,
          onUpdate: tryPlay,
          onRefresh: tryPlay,
        });

        const onScroll = () => tryPlay();
        window.addEventListener('scroll', onScroll, { passive: true });
        const lenis = getLenis();
        lenis?.on('scroll', onScroll);
        scrollListeners.push(() => {
          window.removeEventListener('scroll', onScroll);
          lenis?.off('scroll', onScroll);
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterSplit);
  } else {
    initFooterSplit();
  }

  document.addEventListener('astro:page-load', initFooterSplit);
  document.addEventListener('astro:before-swap', () => {
    initToken += 1;
    cleanup();
  });
</script>
