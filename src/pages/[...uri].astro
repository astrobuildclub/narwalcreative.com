---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { getNodeData, getTemplateByRoute } from '../lib/routes';
import { getSiteSettings } from '../lib/sanity';
import { getSeoData } from '../lib/seo-helpers';

// SSR: nodig voor Visual Editing (drafts per request)
export const prerender = false;

// Dynamische parameter ophalen
const { uri } = Astro.params;
const slug = uri ? `/${uri}/` : '/';

// API routes worden afgehandeld door Netlify functions
// Laat Netlify deze routes verwerken - niet onderscheppen hier

function isNotFoundError(error: unknown): boolean {
  return (
    error instanceof Error &&
    (error.message.includes('not found') ||
      error.message.includes('Page with slug') ||
      error.message.includes('Project with slug'))
  );
}

let node: Awaited<ReturnType<typeof getNodeData>> | null = null;
let Template: ReturnType<typeof getTemplateByRoute> | null = null;

try {
  node = await getNodeData(slug);
  Template = getTemplateByRoute(node);
} catch (error) {
  if (isNotFoundError(error)) {
    Astro.response.status = 404;
  } else {
    throw error;
  }
}

// Haal site settings op voor SEO fallbacks
const siteSettings = await getSiteSettings();

// Build URL voor deze pagina
const pageUrl = Astro.site
  ? `${Astro.site}${slug === '/' ? '' : slug}`
  : `https://accessible-astro.dev${slug === '/' ? '' : slug}`;

// Get SEO data met fallbacks
const seoData = node
  ? getSeoData(
      node.seo,
      siteSettings,
      node.title,
      'Our amazing studio from Rotterdam',
      pageUrl,
    )
  : getSeoData(
      undefined,
      siteSettings,
      'Page not found',
      'The page you are looking for could not be found.',
      pageUrl,
    );

// Debug logging (uitgecomment - alleen nodig bij troubleshooting)
// if (import.meta.env.DEV) {
//   console.log('📊 Page:', { slug, hasSeo: !!node.seo, seoKeys: node.seo ? Object.keys(node.seo) : [] });
// }
---

<DefaultLayout
  title={seoData.title}
  description={seoData.description}
  seo={seoData}
  url={pageUrl}
>
  {
    node && Template ? (
      <Template data={node} />
    ) : (
      <main class="container">
        <h1>Pagina niet gevonden</h1>
        <p>De pagina die je zoekt bestaat niet of is verplaatst.</p>
      </main>
    )
  }
</DefaultLayout>
